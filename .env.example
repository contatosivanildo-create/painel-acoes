# =====================================================================
#  MODELO das variáveis do SERVIDOR (Railway) — pode compartilhar este
# =====================================================================
# Este arquivo é só uma REFERÊNCIA do que precisa ser configurado no painel
# do Railway (aba "Variables" do serviço). NÃO crie um arquivo .env com
# valores reais e NÃO envie segredos para o GitHub.
#
# No seu computador, o login do primeiro administrador continua vindo de
# .streamlit/secrets.toml. No servidor, vem destas variáveis.

# Login do primeiro administrador (criado uma única vez, na primeira execução).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_FULL_NAME=Sivanildo Martins
ADMIN_EMAIL=contato.sivanildo@gmail.com

# Caminho do banco de dados dentro do disco permanente (Volume) do Railway.
# O Volume precisa estar montado em /data.
STOCKS_APP_DB=/data/app.db

# Chave da API da Anthropic, usada pela "Análise do Dia" (botão na página Ações).
# Sem ela, o app funciona normalmente e o botão mostra um aviso amigável.
# Crie em https://console.anthropic.com/settings/keys  (começa com "sk-ant-").
ANTHROPIC_API_KEY=sk-ant-coloque-a-sua-chave-aqui
