# =====================================================================
#  MODELO de secrets.toml  (arquivo de exemplo — pode compartilhar este)
# =====================================================================
# Copie este arquivo para  secrets.toml  (na mesma pasta .streamlit) e
# preencha com os seus dados. O arquivo secrets.toml NÃO deve ser
# compartilhado nem enviado para a internet.
#
# Os valores ADMIN_* são usados UMA VEZ: na primeira vez que o app roda, quando
# ainda não existe nenhum usuário, para criar o primeiro administrador.

ADMIN_USERNAME  = "admin"
ADMIN_PASSWORD  = "defina-uma-senha-aqui"
ADMIN_FULL_NAME = "Seu Nome Completo"
ADMIN_EMAIL     = "voce@exemplo.com"

# Chave da API da Anthropic, usada pela "Análise do Dia" (botão na página Ações).
# Opcional: sem ela o app funciona e o botão mostra um aviso amigável.
# Crie em https://console.anthropic.com/settings/keys  (começa com "sk-ant-").
ANTHROPIC_API_KEY = "sk-ant-coloque-a-sua-chave-aqui"
